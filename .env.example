# Shared Brain
BRAIN=neo4j                  # neo4j | memory (in-process, for demos without Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# LLM: pick one provider
LLM_PROVIDER=anthropic       # anthropic | openai | mock (deterministic, no key needed)
LLM_MODEL=                   # anthropic defaults to claude-opus-5; required for openai (server-specific, e.g. gpt-4o, llama3.1)
LLM_EFFORT=medium            # low | medium | high. anthropic: effort; openai: reasoning_effort. Empty = omit

ANTHROPIC_API_KEY=

# openai = any OpenAI-compatible chat-completions server: OpenAI itself (leave base URL empty), Ollama
# (http://localhost:11434/v1), vLLM, Groq, OpenRouter, LM Studio, or a gateway. Key may stay empty for local servers.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Context budgets
RECENT_LIMIT=10
MEMORY_LIMIT=8
MIN_CONFIDENCE=0.6
LOG_LEVEL=INFO
